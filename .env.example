# AI Resume Builder — environment variables
# Copy to .env and fill in values as needed.

# HTTP server port
PORT=8080

# SQLite database file path
CV_DB_PATH=data/cv.db

# Google Cloud Translation API (profile translation)
GOOGLE_TRANSLATE_API_KEY=

# OpenAI API (AI assistant and OpenAI translation provider)
OPENAI_API_KEY=
# Default chat/translation model when not overridden in the UI
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Planned providers (not used yet)
GOOGLE_GEMINI_API_KEY=
XIAOMI_API_KEY=

# Chrome/Chromium path for PDF export (set automatically in Docker)
# CHROME_PATH=/usr/bin/chromium-browser
