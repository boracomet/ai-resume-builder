# HTTP sunucu portu
PORT=8080

# SQLite veritabanı dosya yolu
CV_DB_PATH=data/cv.db

# Google Cloud Translation API (çeviri özelliği)
GOOGLE_TRANSLATE_API_KEY=

# Gelecek AI özellikleri için (henüz kullanılmıyor)
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
XIAOMI_API_KEY=

# Chrome/Chromium yolu (Docker'da otomatik ayarlanır)
# CHROME_PATH=/usr/bin/chromium-browser
